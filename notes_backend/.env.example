# Flask core
FLASK_SECRET_KEY=change-me
FLASK_DEBUG=true

# Database - option 1: single URL (recommended)
# For SQLite:
DATABASE_URL=sqlite:///notes.db
# For Postgres (example):
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname

# Database - option 2: components (used only if DATABASE_URL absent)
DB_DIALECT=sqlite
DB_HOST=
DB_PORT=
DB_NAME=notes.db
DB_USER=
DB_PASSWORD=

# Auth
ACCESS_TOKEN_EXPIRES_MINUTES=120
JWT_ALGORITHM=HS256

# CORS
CORS_ORIGINS=*

# OpenAPI
API_TITLE=Notes API
API_VERSION=v1
OPENAPI_VERSION=3.0.3
OPENAPI_URL_PREFIX=/docs
OPENAPI_SWAGGER_UI_URL=https://cdn.jsdelivr.net/npm/swagger-ui-dist/
